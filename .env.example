# Q-SENSE Environment Configuration
PROJECT_NAME="Q-SENSE"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (PostgreSQL primary, SQLite fallback supported)
# Primary production PostgreSQL:
# DATABASE_URL="postgresql://qsense_user:qsense_pass@localhost:5432/qsense_db"
# Local development fallback:
DATABASE_URL="sqlite:///database/qsense.db"

# Spatio-Temporal Parameters
SPATIAL_RADIUS_METERS=500.0
TEMPORAL_WINDOW=5

# Quantum Engine Configuration
NUM_QUBITS=4
NUM_LAYERS=2
QUANTUM_SHOTS=1024
QUANTUM_SEED=42
QUANTUM_OPTIMIZER="COBYLA"

# Adaptive Fusion Parameters
FUSION_BASE_ALPHA=0.10
FUSION_ANOMALY_GAIN=0.60
FUSION_SPATIAL_GAIN=0.20
FUSION_TEMPORAL_GAIN=0.20
FUSION_MAX_ALPHA=0.90
